{
  "name": "nld-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Natural Language Disambiguators: order-tolerant, filler-ignoring, best-first parsers for turning natural language into structured commands. Runs natively in the browser; a TypeScript port of @pchiusano/nlds.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:browser"
  },
  "packageManager": "pnpm@9.15.1",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.1",
    "typescript": "^5.9",
    "vitest": "^4"
  }
}
